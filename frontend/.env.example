# ─── Backend API URL ────────────────────────────────────────
# LOCAL DEVELOPMENT (recommended): leave this UNSET / commented out.
#   The app then calls the relative "/api", and the Vite dev server proxies it
#   to the backend on :5000 (see vite.config.js). No CORS, no hardcoded URL.
#   Only set it locally if your backend runs somewhere other than :5000 — and
#   in that case, prefer setting BACKEND_ORIGIN (used by the proxy) instead.
# VITE_API_URL=

# PRODUCTION: set this to your deployed backend's absolute URL (no trailing
# slash), because there is no dev proxy in a production build.
#   VITE_API_URL=https://your-backend.onrender.com/api

# ─── Stripe publishable key ─────────────────────────────────
# Safe to expose to the browser — from https://dashboard.stripe.com/test/apikeys.
# Must belong to the same Stripe account whose STRIPE_SECRET_KEY is set in
# backend/.env. Leave as the placeholder while PAYMENT_MODE="mock" in the backend.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# ─── (optional) Proxy target override for local dev ─────────
# Only needed if your backend dev server is NOT on http://localhost:5000.
# Consumed by vite.config.js's dev proxy, not by the app at runtime.
# BACKEND_ORIGIN=http://localhost:5000

# ─── (optional) Error tracking — Sentry ──────────────────────
# Leave unset to run with error tracking disabled (the default — no SDK
# network calls happen without a DSN). Only takes effect in a production
# build even if set, so local dev never sends events.
# 1. https://sentry.io -> create a project (Platform: React).
# 2. Settings -> Client Keys (DSN) -> copy the DSN below.
# VITE_SENTRY_DSN=

# ─── (optional) Analytics — Google Analytics 4 ───────────────
# Leave unset to run with analytics disabled. Only takes effect in a
# production build even if set, so local dev traffic is never counted.
# 1. https://analytics.google.com -> Admin -> create a GA4 property + a Web
#    data stream for your production domain.
# 2. Copy the Measurement ID (format: G-XXXXXXXXXX) below.
# VITE_GA_MEASUREMENT_ID=
