generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id                       String    @id @default(auto()) @map("_id") @db.ObjectId
  name                     String
  email                    String    @unique
  password                 String
  role                     Role      @default(EV_USER)
  isBlocked                Boolean   @default(false)
  isVerified               Boolean   @default(false)
  verificationOtpHash      String?
  verificationOtpExpiry    DateTime?
  verifiedAt               DateTime?
  verificationAttempts     Int       @default(0)
  lastVerificationAttempt  DateTime?
  verificationBlockedUntil DateTime?
  lastOtpSentAt            DateTime?
  phone                    String?
  avatar                   String?
  resetTokenHash           String?
  resetTokenExpiry         DateTime?
  // Set to now() by POST /api/auth/logout. Any JWT issued before this
  // moment (compared against its `iat` claim) is rejected by `authenticate`
  // even though its signature is still valid — this is what makes logout
  // actually do something server-side, not just a client-side token
  // deletion. Logs out every device/tab at once (no per-token granularity),
  // which is the right amount of complexity for this app's scale.
  tokenValidAfter          DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  evs         EV[]
  bookings    Booking[]
  bids        Bid[]
  reviews     Review[]
  station     ChargingStation?
  payments    Payment[]
  auctionsWon Auction[]
}

enum Role {
  EV_USER
  STATION_OWNER
  ADMIN
}

model EV {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  userId            String   @db.ObjectId
  model             String
  batteryCapacity   Float
  batteryPercentage Float    @default(100)
  licensePlate      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings         Booking[]
  bookingsAsActual Booking[] @relation("ActualEV")

  // MongoDB doesn't auto-index relation scalar fields the way a relational
  // FK constraint would — every prisma.eV.findFirst/findMany({where:{userId}})
  // (booking.controller.js, ev.controller.js, slot.controller.js's auction
  // resolution) would otherwise be a full collection scan.
  @@index([userId])
}

model ChargingStation {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  ownerId      String        @unique @db.ObjectId
  name         String
  address      String
  city         String
  latitude     Float
  longitude    Float
  status       StationStatus @default(PENDING)
  pricePerKwh  Float
  totalRevenue Float         @default(0)
  // Selected from a fixed checklist (station.controller.js's ALLOWED_AMENITIES)
  // rather than free text, so the frontend can render them as a consistent
  // badge/icon set instead of arbitrary strings.
  amenities    String[]      @default([])
  // Base64 data-URL images, client-side compressed before upload (mirrors
  // the avatar pattern in Profile.jsx/user.routes.js), capped at
  // MAX_STATION_IMAGES entries of MAX_IMAGE_BYTES each.
  images       String[]      @default([])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  owner          User                   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  slots          Slot[]
  reviews        Review[]
  updateRequests StationUpdateRequest[]

  // status is filtered on literally every call to the public listing
  // (always WHERE status = APPROVED), and city is the most common
  // additional filter — a single compound index serves both "all approved
  // stations" (using just the status prefix) and "approved stations in
  // city X" (using both fields), same pattern as Booking's compound index
  // below.
  @@index([status, city])
}

// Once a station is APPROVED, its owner can no longer change address/city/
// coordinates/price directly (see updateStation in station.controller.js) —
// those fields go through here instead, and only take effect once an admin
// approves the request. Name, amenities, and images stay directly editable;
// they don't affect where a customer physically drives to or what they're
// charged. A station may have at most one PENDING request at a time — a new
// submission overwrites it rather than queuing a second one.
model StationUpdateRequest {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  stationId   String        @unique @db.ObjectId
  address     String?
  city        String?
  latitude    Float?
  longitude   Float?
  pricePerKwh Float?
  status      RequestStatus @default(PENDING)
  adminNote   String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  reviewedAt  DateTime?

  station ChargingStation @relation(fields: [stationId], references: [id], onDelete: Cascade)
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum StationStatus {
  PENDING
  APPROVED
  REJECTED
  INACTIVE
}

model Slot {
  id                        String     @id @default(auto()) @map("_id") @db.ObjectId
  stationId                 String     @db.ObjectId
  slotNumber                Int
  status                    SlotStatus @default(AVAILABLE)
  powerKw                   Float
  auctionOpen               Boolean    @default(false)
  auctionEnd                DateTime?
  // Set by the station owner when opening an auction (openAuction) — EV users
  // never set these, they only place bids that must meet/exceed them.
  auctionStartingBid        Float? // minimum a first bid must meet
  auctionMinIncrement       Float? // optional; once there's a leading bid, a new bid must beat it by at least this much
  auctionReservationMinutes Int? // how long a winning bidder has to check in before the slot cascades to the next-ranked bidder
  createdAt                 DateTime   @default(now())
  updatedAt                 DateTime   @updatedAt

  station  ChargingStation @relation(fields: [stationId], references: [id], onDelete: Cascade)
  bookings Booking[]
  bids     Bid[]
  auctions Auction[]

  // Backstops the check-then-insert in slot.controller.js's addSlot: without
  // this, two concurrent requests can both pass the pre-check and both
  // insert, leaving two slots with the same number on one station.
  @@unique([stationId, slotNumber])
}

enum SlotStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  MAINTENANCE
  OFFLINE
  FAULTED
}

model Booking {
  id                 String        @id @default(auto()) @map("_id") @db.ObjectId
  userId             String        @db.ObjectId
  evId               String        @db.ObjectId
  slotId             String        @db.ObjectId
  status             BookingStatus @default(PENDING)
  startTime          DateTime
  plannedEndTime     DateTime? // scheduled end of the reserved window; null = open-ended (auction wins / legacy)
  endTime            DateTime? // actual end, set at completion; billing uses this, not the plan
  totalCost          Float?
  finalEnergyKwh     Float? // server-calculated meter total captured when charging ends
  durationMinutes    Int? // actual charging duration captured when charging ends
  finalBill          Float? // final energy charge at the station rate when charging ends
  stopReason         String? // required when an owner uses the emergency-stop workflow
  ratePerKwh         Float? // rate snapshot used for the final session calculation
  emergencyStoppedBy String?       @db.ObjectId // user id that triggered an emergency stop
  emergencyStoppedAt DateTime? // exact time the emergency-stop action completed

  // ─── Check-in / pay-upfront flow ─────────────────────────────
  checkInTime       DateTime? // set when the customer confirms arrival at the station
  chargingStartedAt DateTime? // set server-side when payment activates the charger
  paymentDeadline   DateTime? // checkInTime + grace period; auto-cancelled if unpaid past this
  actualEvId        String?   @db.ObjectId // EV actually charged, if swapped at check-in (defaults to evId)
  // Battery % snapshots for Usage Analytics. batteryBefore is captured from
  // the charging EV at check-in; batteryAfter is derived when the session
  // ends from energy delivered / EV.batteryCapacity (see utils/battery.js) —
  // there's no real telemetry, so this is an estimate, not a meter reading.
  // Null for any booking that never reached CHECKED_IN/COMPLETED.
  batteryBefore     Float?
  batteryAfter      Float?
  paymentIntentId   String? // Stripe PaymentIntent for the locked-in upfront amount
  overageAmount     Float? // extra owed if actual charging time exceeds the paid-for duration
  cancelReason      String? // NO_SHOW | PAYMENT_TIMEOUT | OWNER_CANCELLED | USER_CANCELLED | AUCTION_RESERVATION_EXPIRED

  // Auction-win reservation window: set only on bookings created by
  // resolveAuctionForSlot/cascadeExpiredReservation. If the winner doesn't
  // check in before this passes, the reservation cascades to the next-ranked
  // bidder (see utils/auctionExpiry.js). Null for ordinary bookings.
  reservationDeadline DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ev       EV       @relation(fields: [evId], references: [id], onDelete: Cascade)
  actualEv EV?      @relation("ActualEV", fields: [actualEvId], references: [id])
  slot     Slot     @relation(fields: [slotId], references: [id], onDelete: Cascade)
  payment  Payment?

  @@index([slotId, status, startTime])
}

// Verified-purchase station reviews: a user may review a station only after
// completing AND paying for a charging session there, and holds exactly ONE
// (editable) review per station.
model Review {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  stationId String   @db.ObjectId
  rating    Int // 1-5 stars
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  station ChargingStation @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@unique([userId, stationId])
  // The unique index above leads with userId, so it can't efficiently serve
  // ratingStatsFor's stationId-only lookups (station cards/detail pages).
  @@index([stationId])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN // arrived, EV confirmed, awaiting payment (paymentDeadline running)
  ACTIVE // paid, charging in progress
  COMPLETED
  CANCELLED
}

// One row per auction ROUND on a slot — created when the owner opens an
// auction, and kept forever as a durable history record (unlike Slot's own
// auctionOpen/auctionStartingBid/etc fields, which just reflect the CURRENT
// round and get overwritten the next time the owner opens a new auction on
// the same slot). This is what backs the owner's Auctions page — the only
// place "Completed"/"Cancelled" auction history with each round's own
// starting bid/params can be reconstructed from.
model Auction {
  id                 String        @id @default(auto()) @map("_id") @db.ObjectId
  slotId             String        @db.ObjectId
  startingBid        Float
  minIncrement       Float?
  reservationMinutes Int
  auctionEnd         DateTime
  status             AuctionStatus @default(ACTIVE)
  winnerId           String?       @db.ObjectId
  // PENDING_CONFIRMATION | CONFIRMED | EXPIRED | NO_WINNER — tracks the
  // CURRENT winner's confirmation state as the reservation cascades through
  // ranked bidders (see cascadeExpiredReservation in slot.controller.js).
  winnerStatus       String?
  closedAt           DateTime? // when bidding itself closed (set once, preserved across cascades)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  slot   Slot  @relation(fields: [slotId], references: [id], onDelete: Cascade)
  winner User? @relation(fields: [winnerId], references: [id])
  bids   Bid[]

  @@index([slotId, status])
  @@index([slotId, createdAt])
}

enum AuctionStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model Bid {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  userId       String    @db.ObjectId
  slotId       String    @db.ObjectId
  auctionId    String?   @db.ObjectId // which Auction round this bid belongs to (see Auction model)
  amount       Float
  batteryLevel Float
  priority     Float     @default(0)
  status       BidStatus @default(PENDING)
  // Priority rank (1 = best) among eligible bids, assigned once the auction
  // closes. Drives the winner-doesn't-confirm cascade: the next-lowest rank
  // still PENDING is offered the reservation next. Null until the auction closes.
  rank         Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slot    Slot     @relation(fields: [slotId], references: [id], onDelete: Cascade)
  auction Auction? @relation(fields: [auctionId], references: [id])

  // Backs the leaderboard/eligibility queries (slotId + status='PENDING',
  // ordered by priority) and placeBid's existing-bid lookup (userId + slotId
  // + status), both hit on every bid placement and every auction close.
  @@index([slotId, status])
  @@index([userId, slotId, status])
  @@index([auctionId, priority])
}

enum BidStatus {
  PENDING
  WON
  LOST
  // A bid that WON but whose reservation window lapsed without the bidder
  // checking in — distinct from LOST (simply outranked) so the owner's
  // Auctions page can show "Expired (No Response)" instead of "Not Selected".
  EXPIRED
  CANCELLED
}

model Payment {
  id                    String        @id @default(auto()) @map("_id") @db.ObjectId
  userId                String        @db.ObjectId
  bookingId             String        @unique @db.ObjectId
  amount                Float
  status                PaymentStatus @default(PENDING)
  method                String        @default("SIMULATION")
  stripePaymentIntentId String? // needed to issue a refund via the Stripe API
  refundedAmount        Float? // sum refunded so far — e.g. the unused portion after an emergency stop
  createdAt             DateTime      @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  // GET /payments/history filters by userId; GET /payments/status/:transactionId
  // looks up by stripePaymentIntentId directly.
  @@index([userId])
  @@index([stripePaymentIntentId])
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Log {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String?  @db.ObjectId
  action    String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  // The admin logs page (admin.controller.js) always sorts by createdAt desc.
  @@index([createdAt])
}

// "Contact Us" submissions. Deliberately relation-free (like Log): the
// complainer's name/email/phone are stored inline so the admin can always
// reply even if the account is later deleted, and guests can complain too.
model Complaint {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String?  @db.ObjectId // set when the complainer was logged in
  name      String
  email     String
  phone     String? // enables the WhatsApp reply button in the admin inbox
  subject   String
  message   String
  createdAt DateTime @default(now())

  // Admin inbox sorts newest-first with pagination — same pattern as Log.
  @@index([createdAt])
}
