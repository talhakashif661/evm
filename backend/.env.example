# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real credentials.

# ─── Database ───────────────────────────────────────────────
DATABASE_URL="mongodb://localhost:27017/ev_management"
# Production (MongoDB Atlas):
# DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ev_management?appName=Cluster0"

# ─── JWT ────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="replace_with_a_long_random_secret"
JWT_EXPIRES_IN="7d"

# ─── Server ─────────────────────────────────────────────────
PORT=5000
NODE_ENV="development"

# ─── Frontend URL (used for CORS; admin is merged into this same app) ──
CLIENT_URL="http://localhost:3000"
# Production:
# CLIENT_URL="https://your-frontend.vercel.app"

# ─── SendGrid (Email) ───────────────────────────────────────
# Render's free tier blocks outbound SMTP (ports 25/465/587), so email is
# sent over SendGrid's HTTPS API instead of Gmail/nodemailer SMTP.
# 1. Sign up at https://signup.sendgrid.com (free tier: 100 emails/day).
# 2. Settings -> Sender Authentication -> verify EMAIL_FROM's address (or a
#    whole domain) — SendGrid rejects sends from an unverified sender with a
#    403, even with a valid API key.
# 3. Settings -> API Keys -> Create API Key -> "Restricted Access" with at
#    least "Mail Send" permission -> paste it below.
# Leave SENDGRID_API_KEY empty to run with email disabled (sendEmail()
# no-ops and logs a warning instead of failing the request it's attached to).
SENDGRID_API_KEY=""
EMAIL_FROM="EV Management <your-verified-sender@example.com>"

# ─── KYC / OTP Settings ─────────────────────────────────────
OTP_EXPIRY_MINUTES=10
MAX_VERIFICATION_ATTEMPTS=3
VERIFICATION_BLOCK_HOURS=1
RESEND_COOLDOWN_SECONDS=60

# ─── Booking check-in / payment windows ──────────────────────
NO_SHOW_MINUTES=15
PAYMENT_GRACE_MINUTES=5
# Grace period for an open-ended auction-win booking to be checked into,
# before it's swept as abandoned (windowed bookings use NO_SHOW_MINUTES instead).
AUCTION_WIN_GRACE_HOURS=2

# ─── Auction bidding ──────────────────────────────────────────
# Fixed normalization ceiling for the bid-priority formula (see
# calculatePriority in bid.controller.js) — bids at or above this clamp to a
# normalized 1.0.
BID_REFERENCE_MAX_PKR=2000

# ─── Stripe / Payments ──────────────────────────────────────
# PAYMENT_MODE: "mock" or "live".
#   - Leave unset (or "mock"): payments are simulated server-side — no Stripe
#     API calls happen, no real keys needed. This is also the automatic
#     fallback whenever STRIPE_SECRET_KEY is empty/the placeholder below, so
#     local dev works out of the box even if you forget to set this.
#   - "live": uses the real Stripe API below. Requires real keys, or every
#     payment attempt fails with a Stripe auth error.
PAYMENT_MODE="mock"
# Simulated network delay for mock payments, in milliseconds (purely cosmetic
# — lets the frontend's loading state show instead of resolving instantly).
MOCK_PAYMENT_DELAY=1000

# Get these from https://dashboard.stripe.com/test/apikeys (Secret key) and
# https://dashboard.stripe.com/test/webhooks (Signing secret, after adding an
# endpoint pointing at POST /api/payments/webhook). Only needed once
# PAYMENT_MODE="live" — leave as placeholders for local mock-mode dev.
STRIPE_SECRET_KEY="sk_test_replace_me"
STRIPE_WEBHOOK_SECRET="whsec_replace_me"
# "pkr" or "usd" — flip to "usd" if your Stripe account's country doesn't
# support charging in PKR (Pakistan isn't a Stripe account-holding country,
# so this depends entirely on which country your specific account is in).
STRIPE_CURRENCY="pkr"

# ─── First-time Admin Setup ──────────────────────────────────
# Used ONLY by POST /api/auth/setup-admin (see README) to create the very
# first ADMIN account. Set this to a long random secret, call the endpoint
# once, then rotate or remove it — the endpoint refuses to run again once an
# ADMIN already exists.
ADMIN_SETUP_KEY="replace_with_a_long_random_secret"
