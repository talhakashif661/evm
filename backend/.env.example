# Copy this file to .env and fill in real values. .env is gitignored;
# never commit real credentials.

# Database
DATABASE_URL="mongodb://localhost:27017/ev_management"
# Production (MongoDB Atlas):
# DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ev_management?appName=Cluster0"

# JWT
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="replace_with_a_long_random_secret"
JWT_EXPIRES_IN="7d"

# Server
PORT=5000
NODE_ENV="development"

# On Vercel the API uses api/index.js. Socket.IO and the 30-second background
# expiry sweep in server.js are not available in that serverless runtime.

# Frontend URL (used for CORS; admin is merged into this same app)
CLIENT_URL="http://localhost:3000"
# Production:
# CLIENT_URL="https://your-frontend.vercel.app"

# SMTP Email (Nodemailer)
# Used for OTP, account verification, password reset, booking, station, and
# auction notification emails. Railway is recommended for backend hosting
# because this project needs outbound SMTP.
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER="smtp_username"
SMTP_PASS="smtp_password"
EMAIL_FROM="EV Management <noreply@example.com>"

# KYC / OTP Settings
OTP_EXPIRY_MINUTES=10
MAX_VERIFICATION_ATTEMPTS=3
VERIFICATION_BLOCK_HOURS=1
RESEND_COOLDOWN_SECONDS=60

# Booking check-in / payment windows
NO_SHOW_MINUTES=15
PAYMENT_GRACE_MINUTES=5

# Auction bidding
# Fixed normalization ceiling for the bid-priority formula (see
# calculatePriority in bid.controller.js). Bids at or above this clamp to a
# normalized 1.0.
BID_REFERENCE_MAX_PKR=2000
# Fallback reservation window (minutes) for a winning bid to be checked into,
# only used defensively if a slot's own auctionReservationMinutes (set by the
# station owner when opening the auction) is somehow missing.
AUCTION_RESERVATION_DEFAULT_MINUTES=10

# Stripe / Payments
# PAYMENT_MODE: "mock" or "live".
#   - Leave unset (or "mock"): payments are simulated server-side; no Stripe
#     API calls happen, no real keys needed.
#   - "live": uses the real Stripe API below. Requires real keys, or every
#     payment attempt fails with a Stripe auth error.
PAYMENT_MODE="mock"
# Simulated network delay for mock payments, in milliseconds.
MOCK_PAYMENT_DELAY=1000

# Get these from https://dashboard.stripe.com/test/apikeys (Secret key) and
# https://dashboard.stripe.com/test/webhooks (Signing secret, after adding an
# endpoint pointing at POST /api/payments/webhook). Only needed once
# PAYMENT_MODE="live"; leave as placeholders for local mock-mode dev.
STRIPE_SECRET_KEY="sk_test_replace_me"
STRIPE_WEBHOOK_SECRET="whsec_replace_me"
# "pkr" or "usd". Flip to "usd" if your Stripe account's country doesn't
# support charging in PKR.
STRIPE_CURRENCY="pkr"

# Optional error tracking: Sentry
# Leave empty to run with error tracking disabled (the default). Only takes
# effect when NODE_ENV=production even if set, so local dev never sends events.
SENTRY_DSN=""

# First-time Admin Setup
# Used only by POST /api/auth/setup-admin to create the first ADMIN account.
# Set this to a long random secret, call the endpoint once, then rotate or
# remove it. The endpoint refuses to run again once an ADMIN already exists.
ADMIN_SETUP_KEY="replace_with_a_long_random_secret"
